{
  "name": "nexa",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "scripts": {
    "build:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-windows.ps1",
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "lint": "eslint src vite.config.ts eslint.config.js --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "format": "prettier --write \"src/**/*.{vue,ts,js,css,scss,less}\" index.html vite.config.ts eslint.config.js package.json .prettierrc.json tsconfig.json tsconfig.node.json",
    "format:check": "prettier --check \"src/**/*.{vue,ts,js,css,scss,less}\" index.html vite.config.ts eslint.config.js package.json .prettierrc.json tsconfig.json tsconfig.node.json",
    "check:ui": "npm run format && npm run lint && npm run format:check && npm run build",
    "preview": "vite preview",
    "tauri": "tauri"
  },
  "dependencies": {
    "@lucide/vue": "^1.52.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2.4.1",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-notification": "^2.5.1",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-os": "^2.4.0",
    "vue": "^3.5.13"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.7",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.0.16",
    "vue-tsc": "^3.3.5"
  }
}
